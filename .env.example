# NeoRouter — copied to ~/.neorouter/.env by `neorouter setup`.
# Every other setting has a sensible default; see docs/configuration.md.
NEOROUTER_HOST=127.0.0.1
NEOROUTER_PORT=4600
NEOROUTER_PUBLIC_URL=http://127.0.0.1:4600
NEOROUTER_RELEASE_CHANNEL=beta
NEOROUTER_TRUST_PROXY=false
NEOROUTER_LOG_LEVEL=info
