# NeoRouter — copied to ~/.neorouter/.env by `neorouter install`.
# Every other setting has a sensible default; see docs/configuration.md.
NEOROUTER_HOST=127.0.0.1
NEOROUTER_PORT=4600
NEOROUTER_PUBLIC_URL=http://127.0.0.1:4600
NEOROUTER_RELEASE_CHANNEL=stable
NEOROUTER_TRUST_PROXY=false
NEOROUTER_LOG_LEVEL=info

## Email (optional): enables "Forgot password?" on the sign-in page, together
## with a public address (NEOROUTER_PUBLIC_URL or NEOROUTER_EMAIL_PUBLIC_URL).
# NEOROUTER_EMAIL_SMTP_HOST=smtp.example.com
# NEOROUTER_EMAIL_SMTP_PORT=587
# NEOROUTER_EMAIL_SMTP_USER=
# NEOROUTER_EMAIL_SMTP_PASS=
# NEOROUTER_EMAIL_FROM=neorouter@example.com
# NEOROUTER_EMAIL_PUBLIC_URL=

# If you're comfortable sharing coarse usage and reliability statistics, please
# leave analytics enabled. It helps us improve the app. Set to false to opt out
# of browser and server analytics for this deployment.
ANALYTICS_ENABLED=true
