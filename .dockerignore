# Keeps the build context to what the image needs: the Go sources, the landing
# page and the built dashboard. Runtime data never belongs in an image: it lives
# in the /data volume.
.git
.github
.gitignore
.gitattributes
go.work
go.work.sum
node_modules
**/node_modules

# Docs, tests, videos and tooling are not needed to build or run the server.
test
docs
videos
hardware
landing/*.md
README.md
AGENTS.md
CLAUDE.md
GUIDELINES.md
CONTRIBUTING.md
SECURITY.md
scripts

# Flutter sources are not compiled here: only the dashboard the checkout ships
# (flutter_app/build/web) goes into the image.
flutter_app/build/*
!flutter_app/build/web
flutter_app/.dart_tool
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.packages
flutter_app/.pub
flutter_app/linux
flutter_app/macos
flutter_app/windows
flutter_app/test
flutter_app/.idea
flutter_app/**/ephemeral
flutter_app/android

# Local state and secrets.
.env
.env.*
!.env.example
!.env.*.example
*.sqlite
*.sqlite3
*.db
*.pem
*.p12
*.log
logs
coverage
coverage.*
runtime-data
deployment/data
.neorouter-dev
tmp
.DS_Store
/build
/dist
/bin/neorouter

# Container files themselves are cheap; the image copies the entrypoint and the
# container defaults from here.
!docker/**