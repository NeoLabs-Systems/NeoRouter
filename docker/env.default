# Container defaults, seeded as /data/.env on first start.
# The image already sets NEOROUTER_HOME=/data, NEOROUTER_HOST=0.0.0.0 and
# NEOROUTER_PORT=4600, and a process environment variable wins over this file:
# change those with `docker run -e` or compose `environment:`, not here.
#
# Set this to the URL browsers and OpenAI/Anthropic clients use; it is shown in
# the dashboard and used for OAuth callbacks.
# NEOROUTER_PUBLIC_URL=https://router.example.com
# Only enable behind a reverse proxy that sets X-Forwarded-* itself: trusting
# those headers without one lets a client choose its own IP for rate limits.
# NEOROUTER_TRUST_PROXY=true
NEOROUTER_RELEASE_CHANNEL=stable
NEOROUTER_LOG_LEVEL=info
