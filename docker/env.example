# NeoRouter container defaults: copied to /data/.env on first start when there
# is no configuration yet. This is the complete set of settings the server
# reads; ../docs/configuration.md describes each one.
#
# A process environment variable wins over this file, so use `docker run -e` or
# compose `environment:` when a value must not be editable from inside the
# container. NEOROUTER_HOME, NEOROUTER_HOST and NEOROUTER_PORT are set by the
# image itself.
#
# The release channel is normally chosen at build time
# (--build-arg NEOROUTER_CHANNEL=beta|stable), which selects both the code and
# the dashboard. Change it here only to follow another channel from the CLI.

## Server

NEOROUTER_HOST=0.0.0.0
NEOROUTER_PORT=4600
# Set this to the URL browsers and OpenAI/Anthropic clients use; it is shown in
# the dashboard and used for OAuth callbacks.
# NEOROUTER_PUBLIC_URL=https://router.example.com
NEOROUTER_RELEASE_CHANNEL=beta
# Only enable behind a reverse proxy that sets X-Forwarded-* itself: trusting
# those headers without one lets a client choose its own IP for rate limits.
NEOROUTER_TRUST_PROXY=false
# Let every user, not only the instance admin, point providers at loopback and
# private network addresses. Needed when a shared instance reaches an Ollama or
# LM Studio on the host through host.docker.internal.
NEOROUTER_ALLOW_PRIVATE_PROVIDER_URLS=false
# Extra CORS origins, comma separated; loopback is always allowed.
# NEOROUTER_ALLOWED_ORIGINS=https://app.example.com
NEOROUTER_LOG_LEVEL=info
# NEOROUTER_SESSION_TTL_MS=2592000000
# Development only: redirect /app to a running `flutter run -d web-server`.
# NEOROUTER_WEB_DEV_URL=

## Routing

# NEOROUTER_UPSTREAM_TIMEOUT_MS=120000
# NEOROUTER_ROUTING_MAX_ATTEMPTS=8
# NEOROUTER_ROUTING_TOTAL_BUDGET_MS=300000
# NEOROUTER_ROUTING_TOP_K=5
# NEOROUTER_ROUTING_HEDGING=true
# NEOROUTER_ROUTING_MAX_PARALLEL=3
# NEOROUTER_ROUTING_HEDGE_UNMEASURED_MS=10000
# NEOROUTER_ROUTING_QUEUE_WAIT_MS=45000

## Background jobs

# Key checks, model sync, metadata refresh and quota probes.
# NEOROUTER_WORKERS_ENABLED=true
# NEOROUTER_VALIDATE_INTERVAL_MS=300000
# NEOROUTER_MODEL_SYNC_INTERVAL_MS=21600000
# NEOROUTER_METADATA_INTERVAL_MS=3600000
# NEOROUTER_QUOTA_PROBE_INTERVAL_MS=900000
# Disable to run fully offline.
# NEOROUTER_METADATA_SOURCES_ENABLED=true

## Limits

# NEOROUTER_MAX_BODY_BYTES=33554432

## Storage

# Overrides the database location; the default is /data/data/neorouter.sqlite3.
# It must stay inside the volume, or the data is lost with the container.
# NEOROUTER_DATABASE_PATH=

## Overrides, for proxies and self-hosted gateways

# The ChatGPT/Codex plan sign-in endpoints, for a mirror in front of them.
# NEOROUTER_CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
# NEOROUTER_CODEX_ISSUER=https://auth.openai.com
