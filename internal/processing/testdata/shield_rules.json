  "kind": "rule",
  "file": "secrets.js",
  "match": [
   {
    "text": "Cookie: session=abc123def456; theme=dark",
    "value": "session=abc123def456; theme=dark"
   }
  ],
  "ignore": []
 },
 {
  "id": "webhook_url",
  "kind": "rule",
  "file": "secrets.js",
  "match": [
   {
    "text": "https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX"
   },
   {
    "text": "https://discord.com/api/webhooks/123456789/abcDEF-ghi"
   }
  ],
  "ignore": []
 },
 {
  "id": "signed_url_param",
  "kind": "rule",
  "file": "secrets.js",
  "match": [
   {
    "text": "https://bucket.s3.amazonaws.com/f.pdf?X-Amz-Signature=8f2a9c1d7e3b",
    "value": "8f2a9c1d7e3b"
   },
   {
    "text": "https://x.blob.core.windows.net/c?sv=2022&sig=AbC%2Fdef123",
    "value": "AbC%2Fdef123"
   }
  ],
  "ignore": [
   "https://example.org/?page=2&sort=newest"
  ]
 },
 {
  "id": "one_time_code",
  "kind": "rule",
  "file": "secrets.js",
  "match": [
   {
    "text": "Your verification code is 482913"
   },
   {
    "text": "TAN: 553201"
   }
  ],
  "ignore": [
   "error code 5003 occurred",
   "in 2026"
  ]
 },
 {
  "id": "high_entropy_token",
  "kind": "rule",
  "file": "secrets.js",
  "match": [
   {
    "text": "token wJalrXUtnFEMI/K7MDENG/bPxRfiCYzEXAMPLEKEY9"
   }
  ],
  "ignore": [
   "commit 9fceb02d0ae598e95dc970b74767f19372d61af8"
  ]
 },
