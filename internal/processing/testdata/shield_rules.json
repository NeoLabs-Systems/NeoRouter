   },
   {
    "text": "Termin mit Frau Schneider morgen",
    "value": "Schneider"
   },
   {
    "text": "Dear Mr. Thompson,",
    "value": "Thompson"
   },
   {
    "text": "Gespräch mit Richard von Weizsäcker",
    "value": "von Weizsäcker"
   },
   {
    "text": "Viele Grüße\nMaria Müller-Lüdenscheid",
    "value": "Müller-Lüdenscheid"
   },
   {
    "text": "Teilnehmer: Schmidt, Anna",
    "value": "Schmidt"
   },
   {
    "text": "Mike Wojciechowski called",
    "value": "Wojciechowski"
   },
   {
    "text": "hallo, ich bin anna schmidt",
    "value": "schmidt"
   },
   {
    "text": "grüße\njonas becker",
    "value": "becker"
   },
   {
    "text": "herr müller hat angerufen",
