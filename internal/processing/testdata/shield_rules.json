 {
  "id": "postal_address",
  "kind": "detector",
  "file": "address.js",
  "match": [
   {
    "text": "Ich wohne in der Hauptstraße 5, 10115 Berlin.",
    "value": "Hauptstraße 5, 10115 Berlin"
   },
   {
    "text": "Lieferung an Berliner Straße 12a",
    "value": "Berliner Straße 12a"
   },
   {
    "text": "Adresse: Am Markt 3",
    "value": "Am Markt 3"
   },
   {
    "text": "Ship to 1600 Pennsylvania Avenue, Washington, DC 20500",
    "value": "1600 Pennsylvania Avenue, Washington, DC 20500"
   },
   {
    "text": "Karl-Marx-Allee 34\n10178 Berlin",
    "value": "Karl-Marx-Allee 34\n10178 Berlin"
   }
  ],
  "ignore": [
   "Im Jahr 2026",
   "Der Platz 3 ging an uns",
   "10115 Berlin ist schön",
   "Kapitel 3"
  ]
 },
 {
  "id": "last_names",
  "kind": "detector",
  "file": "names.js",
  "match": [
   {
    "text": "Hallo, ich bin Anna Schmidt.",
